{
  "name": "@markov/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/main.ts"
  },
  "dependencies": {
    "@markov/config": "workspace:*",
    "@markov/contracts": "workspace:*",
    "@markov/db": "workspace:*",
    "@markov/observability": "workspace:*",
    "@markov/registry": "workspace:*",
    "@markov/solana-rpc": "workspace:*"
  },
  "devDependencies": {
    "@markov/testkit": "workspace:*"
  }
}
