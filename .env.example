# Markov backend configuration. Copy to .env for local development; never
# commit .env. Empty values are treated as unset. Every variable is validated
# by packages/config at boot; invalid combinations refuse to start.

# Runtime mode: local | test | staging | mainnet-read-only | production
MARKOV_ENV=local
# Build identifier reported by /healthz (git sha or tag in deployed builds)
SERVICE_VERSION=dev

# Logging: fatal|error|warn|info|debug|trace|silent ; json|pretty (pretty is dev-only)
LOG_LEVEL=info
LOG_FORMAT=pretty

# HTTP API
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated exact origins allowed for credentialed browser requests. Wildcards are rejected.
API_ALLOWED_ORIGINS=
API_TRUST_PROXY=false
API_RATE_LIMIT_MAX_PER_MINUTE=300
API_BODY_LIMIT_BYTES=262144

# PostgreSQL (the password embedded here is redacted from logs and summaries)
DATABASE_URL=postgres://markov:markov@127.0.0.1:5432/markov_dev
# disable | require (defaults: disable for local/test, require otherwise)
DATABASE_SSL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Temporal
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_PLATFORM=markov-platform
TEMPORAL_TLS=false
TEMPORAL_API_KEY=

# Solana network identity. The genesis hash of public clusters is pinned in
# code; set SOLANA_EXPECTED_GENESIS_HASH only for localnet.
SOLANA_CLUSTER=devnet
SOLANA_EXPECTED_GENESIS_HASH=
SOLANA_RPC_PRIMARY_URL=https://api.devnet.solana.com
# Required (different host) in staging, mainnet-read-only and production
SOLANA_RPC_SECONDARY_URL=
SOLANA_RPC_TIMEOUT_MS=5000
SOLANA_RPC_MAX_RESPONSE_BYTES=2097152
SOLANA_READ_COMMITMENT=confirmed

# Execution writes are disabled until later sessions deliver execution and the
# release gates in docs/markov/release-readiness.md are satisfied. Production
# additionally requires every BETA_* cap and a release evidence reference.
EXECUTION_WRITES_ENABLED=false
BETA_MAX_ORDER_NOTIONAL_USDC_RAW=
BETA_MAX_DAILY_NOTIONAL_USDC_RAW=
BETA_MAX_ACCOUNT_NOTIONAL_USDC_RAW=
BETA_PARTICIPANT_ALLOWLIST_ENABLED=
RELEASE_EVIDENCE_REF=

SHUTDOWN_TIMEOUT_MS=10000

# Test-only: integration tests skip themselves unless these are set.
MARKOV_TEST_DATABASE_URL=postgres://markov:markov@127.0.0.1:5432/markov_test
MARKOV_TEST_TEMPORAL_ADDRESS=127.0.0.1:7233

# Web application (apps/web). Only non-secret switches; production refuses
# MARKOV_WEB_FIXTURES and MARKOV_WEB_INTERNAL_ROUTES.
MARKOV_WEB_INTERNAL_ROUTES=true
MARKOV_WEB_FIXTURES=false
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3100
# Server-only origin of the Markov API (defaults to http://127.0.0.1:3000 in local/test; https required elsewhere)
MARKOV_API_ORIGIN=http://127.0.0.1:3000
# Origin serving the documentation site (apps/docs, `pnpm docs:serve`) under /docs. Unset: /docs is not served.
MARKOV_DOCS_ORIGIN=http://127.0.0.1:3200

# Identity provider (B02). `test` mints tokens in-process and is refused
# outside local/test; `oidc` verifies provider tokens against a JWKS.
IDENTITY_PROVIDER=test
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
IDENTITY_JWKS_URL=
IDENTITY_ALGORITHMS=ES256

# Credentials and wallet linking. The pepper hashes every stored secret;
# staging/production require an explicit value of 32+ characters.
CREDENTIAL_PEPPER=
AUTH_SESSION_TTL_SECONDS=86400
AUTH_STEP_UP_MAX_AGE_SECONDS=600
WALLET_CHALLENGE_DOMAIN=localhost
WALLET_CHALLENGE_TTL_SECONDS=300

# Catalog (B03). Operator-configured feed serving the Markov issuer feed
# contract; https outside local/test. Unset until the PreStocks endpoint is
# verified (OD-17); local and test use bundled synthetic fixtures.
PRESTOCKS_FEED_URL=
# xStocks products and corporate-action feeds (B04); same rules. Unset until OD-18 is resolved.
XSTOCKS_FEED_URL=
XSTOCKS_EVENTS_URL=
# Stablecoin mint observed by funding readiness (F04). Defaults to USDC on mainnet-beta;
# devnet/testnet/localnet report SOL only unless a mint is configured here.
FUNDING_STABLECOIN_MINT=
# Research model adapter (B06): disabled (manual research only), fixture (local/test only) or xai
# (Grok over the chat completions API, B17; needs XAI_API_KEY). See docs/markov/agent-permissions.md.
RESEARCH_MODEL_PROVIDER=disabled
# Companion model adapter (B15): disabled (typed agent tools still work; runs answer 503), fixture
# (local/test only) or xai (B17; needs XAI_API_KEY). See docs/markov/agents.md.
COMPANION_MODEL_PROVIDER=disabled
# xAI (Grok): the API key (required by, and only allowed with, a provider set to xai), the base URL
# (https outside local/test), the model, the request timeout and the price the companion cost
# budgets are measured in (micros of a dollar per token; check the current price list).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
XAI_TIMEOUT_MS=30000
XAI_INPUT_MICROS_PER_TOKEN=3
XAI_OUTPUT_MICROS_PER_TOKEN=15
# Companion runs an account may spend per rolling day, in cost micros (default 5000000).
COMPANION_DAILY_COST_LIMIT_MICROS=5000000

# Notifications (B16): in-app notifications always work; email needs a provider. `fixture` records
# messages (local/test only); `configured` posts the Markov email contract to the URL below.
NOTIFICATIONS_EMAIL_PROVIDER=disabled
NOTIFICATIONS_EMAIL_URL=
NOTIFICATIONS_EMAIL_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
# Origin of the app that notification links open (paths only when unset).
NOTIFICATIONS_APP_ORIGIN=

# Maintenance driver (B16, worker only): the API to run maintenance passes against and the worker
# credential (`markov workers create`, scope maintenance:run). Unset: no maintenance workflow starts.
MAINTENANCE_API_URL=
MAINTENANCE_API_TOKEN=
MAINTENANCE_TICK_SECONDS=60
# Recipe complexity limit (B07): at most this many constituent legs, 1..10 (default 10).
STRATEGY_MAX_LEGS=10
# Strategy registry program (B08). Unset keeps publication disabled and the
# indexer idle. Mainnet publication additionally requires MARKOV_ENV=production
# and RELEASE_EVIDENCE_REF; mainnet-read-only indexes and reads only.
REGISTRY_PROGRAM_ID=
# Seconds between indexer passes (apps/indexer), 5..3600 (default 30).
REGISTRY_INDEX_INTERVAL_SECONDS=30
# Execution venue (B09): disabled (no plans), fixture (local/test only; synthetic
# quotes for the fixture mints) or configured_url (an operator-run gateway serving
# the Markov quote contract over https; docs/markov/execution-planning.md). Any
# venue requires FUNDING_STABLECOIN_MINT. The live Jupiter interface is
# unverified (OD-21).
EXECUTION_VENUE_PROVIDER=disabled
EXECUTION_VENUE_QUOTE_URL=
# Optional gateway that builds transactions for its quotes (configured_url only;
# Markov build contract, https outside local/test). Without it plans are quoted
# but no transaction is built (B10, docs/markov/execution-state-machine.md).
EXECUTION_VENUE_BUILD_URL=
# Bearer token for the configured gateway; never logged, never part of a plan.
EXECUTION_VENUE_API_KEY=
# Fixture venue only (local/test): the most constituents composed into one
# transaction; a basket with more legs stays staged. Leave empty for no limit.
# Refused with any other provider (B11, docs/markov/execution-state-machine.md).
EXECUTION_VENUE_FIXTURE_COMPOSE_MAX_LEGS=
# Receipts (B12, docs/markov/accounting-methodology.md): disabled (no receipts,
# the routes answer 503), local_key (RECEIPT_SIGNING_KEY: an Ed25519 PKCS#8 key,
# base64; local/test/staging only, refused in production) or kms (not
# implemented, OD-22). The key id is published with the verification keys.
RECEIPT_SIGNING_PROVIDER=disabled
RECEIPT_SIGNING_KEY=
RECEIPT_SIGNING_KEY_ID=
