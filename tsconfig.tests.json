{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["apps/*/test/**/*.ts", "packages/*/test/**/*.ts", "vitest.config.ts"],
  "exclude": [
    "packages/markov-shell/**",
    "packages/ui/**",
    "packages/formatters/**",
    "packages/api-client/**",
    "apps/web/**",
    "**/node_modules/**",
    "**/dist/**"
  ]
}
