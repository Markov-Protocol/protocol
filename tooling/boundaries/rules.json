{
  "$comment": "Import direction rules enforced by check-boundaries.mjs. Keys are workspace package names; `allow` lists the internal packages each may import. Apps may import any package but never another app. External provider SDK families are restricted to the packages listed under `externalOwners`. `appDeny` lists packages an app may never import (the frontend/backend split of ADR-0006).",
  "layers": {
    "@markov/contracts": {
      "allow": []
    },
    "@markov/config": {
      "allow": ["@markov/contracts"]
    },
    "@markov/observability": {
      "allow": []
    },
    "@markov/solana-rpc": {
      "allow": []
    },
    "@markov/testkit": {
      "allow": []
    },
    "@markov/db": {
      "allow": ["@markov/contracts"]
    },
    "@markov/formatters": {
      "allow": ["@markov/contracts"]
    },
    "@markov/ui": {
      "allow": ["@markov/contracts", "@markov/formatters"]
    },
    "@markov/shell": {
      "allow": ["@markov/contracts", "@markov/formatters", "@markov/ui"]
    },
    "@markov/auth": {
      "allow": ["@markov/contracts"]
    },
    "@markov/api-client": {
      "allow": ["@markov/contracts"]
    },
    "@markov/catalog": {
      "allow": ["@markov/contracts", "@markov/amounts"]
    },
    "@markov/issuer-prestocks": {
      "allow": ["@markov/contracts", "@markov/catalog"]
    },
    "@markov/amounts": {
      "allow": []
    },
    "@markov/issuer-xstocks": {
      "allow": ["@markov/contracts", "@markov/catalog"]
    }
  },
  "apps": ["@markov/api", "@markov/worker", "@markov/cli", "@markov/web"],
  "testOnlyPackages": ["@markov/testkit"],
  "externalOwners": {
    "@temporalio/": ["@markov/worker", "@markov/cli"],
    "fastify": ["@markov/api"],
    "@fastify/": ["@markov/api"],
    "drizzle-orm": ["@markov/db"],
    "pg": ["@markov/db", "@markov/testkit"],
    "@solana/": [],
    "@jup-ag/": [],
    "@meteora-ag/": [],
    "next": ["@markov/web"],
    "next/": ["@markov/web"],
    "react": ["@markov/ui", "@markov/web", "@markov/shell"],
    "react-dom": ["@markov/ui", "@markov/web", "@markov/shell"],
    "radix-ui": ["@markov/ui"],
    "@radix-ui/": ["@markov/ui"],
    "lucide-react": ["@markov/ui", "@markov/web", "@markov/shell"],
    "jose": ["@markov/auth"],
    "fastify-plugin": ["@markov/api"],
    "openapi-fetch": ["@markov/api-client"],
    "@tanstack/": ["@markov/web"]
  },
  "appDeny": {
    "@markov/web": [
      "@markov/db",
      "@markov/config",
      "@markov/solana-rpc",
      "@markov/observability",
      "@markov/testkit",
      "@markov/auth"
    ],
    "@markov/api": ["@markov/ui", "@markov/formatters", "@markov/shell"],
    "@markov/worker": ["@markov/ui", "@markov/formatters", "@markov/shell"],
    "@markov/cli": ["@markov/ui", "@markov/formatters", "@markov/shell"]
  }
}
